  "lines": [
    { "t": 1.0,   "v": "nar",   "text": "Thirty days. Twenty-five floors up. And no way out." },
    { "t": 9.0,   "v": "nar",   "text": "It started like any other Tuesday night." },
    { "t": 11.6,  "v": "news",  "text": "We interrupt this program. Breaking news. Violent attacks are being reported across the city. Stay inside. Lock your doors.", "cap": false },
    { "t": 19.5,  "v": "nar",   "text": "I went to the window, and looked down." },
    { "t": 27.6,  "v": "man",   "text": "Oh my God...", "rate": 1.15 },
    { "t": 29.6,  "v": "nar",   "text": "The city was falling apart." },
    { "t": 34.0,  "v": "nar",   "text": "Six bottles of water. Four cans of beans." },
    { "t": 37.8,  "v": "nar",   "text": "That was everything I had." },
    { "t": 42.5,  "v": "nar",   "text": "I locked the door, and pushed the dresser in front of it." },
    { "t": 53.0,  "v": "nar",   "text": "On day seven, the power went out." },
    { "t": 58.4,  "v": "nar",   "text": "The whole city went dark." },
    { "t": 63.0,  "v": "nar",   "text": "And then I heard them. In the stairwell." },
    { "t": 70.0,  "v": "nar",   "text": "They found my floor.", "rate": 1.1 },
    { "t": 80.5,  "v": "nar",   "text": "I didn't move. I didn't breathe.", "rate": 1.1 },
    { "t": 87.0,  "v": "nar",   "text": "Day seventeen. One bottle left." },
    { "t": 91.6,  "v": "nar",   "text": "Half full." },
    { "t": 95.2,  "v": "nar",   "text": "I started to wonder if anyone else was still alive." },
    { "t": 101.0, "v": "nar",   "text": "Then, across the street, I saw her." },
    { "t": 104.6, "v": "nar",   "text": "Another survivor." },
    { "t": 112.4, "v": "man",   "text": "Behind you! Get inside! Run!", "rate": 0.85, "loud": true },
    { "t": 118.8, "v": "nar",   "text": "I never saw her again." },
    { "t": 123.0, "v": "nar",   "text": "On day twenty-seven, the radio came back to life." },
    { "t": 127.0, "v": "radio", "text": "To any survivors. Evacuation helicopters will search the city on day thirty. Signal us with a light.", "cap": false },
    { "t": 134.2, "v": "nar",   "text": "Three more days." },
    { "t": 138.0, "v": "nar",   "text": "Day thirty. I almost didn't hear it." },
    { "t": 145.6, "v": "man",   "text": "Hey! Here! I'm here! Over here!", "rate": 0.9, "loud": true },
    { "t": 151.5, "v": "man",   "text": "Please! Please see me!", "rate": 0.95, "loud": true }
  ],

  "lines": [
    ["intro", 1.5, "nar", "My name is Daniel. I live on the twenty-fifth floor."],
    ["intro", 6.5, "nar", "This is the story of the thirty days I couldn't leave my apartment."],

    ["day1", 2.0, "nar", "It started like any other Tuesday night."],
    ["day1", 5.5, "nar", "Pizza, a quiz show, and nothing to worry about."],
    ["day1", 11.0, "news", "We interrupt this program for breaking news.", 1, 42],
    ["day1", 14.8, "news", "Violent attacks are being reported across the entire city. The cause is still unknown.", 1, 42],
    ["day1", 21.5, "news", "Authorities urge everyone to stay inside, lock their doors, and avoid all contact with the infected.", 1, 42],
    ["day1", 29.0, "nar", "At first, I thought it was some kind of joke."],
    ["day1", 33.0, "nar", "Then I heard the sirens."],
    ["day1", 36.5, "nar", "So I went to the window, and looked down."],
    ["day1", 50.0, "man", "Oh my God... what is happening?", 1.1],
    ["day1", 57.0, "nar", "People were running. Cars were crashing."],
    ["day1", 62.0, "nar", "And something was chasing them."],

    ["day3", 2.0, "nar", "By day three, the streets had gone quiet."],
    ["day3", 6.5, "nar", "I opened the fridge, and counted everything I had."],
    ["day3", 12.0, "man", "One, two, three, four, five, six bottles.", 1.05],
    ["day3", 17.5, "man", "Four cans of beans.", 1.05],
    ["day3", 21.0, "nar", "That was it. That was everything."],
    ["day3", 26.0, "nar", "I locked the door. Twice."],
    ["day3", 32.0, "nar", "Then I pushed the dresser in front of it."],
    ["day3", 42.5, "nar", "If something wanted in, it would have to work for it."],

    ["day7", 2.0, "nar", "For a week, the lights stayed on. The TV was just static."],
    ["day7", 8.0, "nar", "I told myself the power would never go out."],
    ["day7", 15.5, "nar", "On day seven, it did."],
    ["day7", 21.0, "nar", "Block by block, the whole city went dark."],
    ["day7", 28.0, "nar", "I found my flashlight, and sat on the floor."],
    ["day7", 35.0, "nar", "And that's when I heard them."],
    ["day7", 40.0, "nar", "In the stairwell. Coming up. Floor by floor."],

    ["day12", 2.0, "nar", "On day twelve, they found my floor.", 1.1],
    ["day12", 16.0, "nar", "Slow footsteps. Right outside my door.", 1.1],
    ["day12", 24.0, "nar", "Then the scratching started.", 1.1],
    ["day12", 37.0, "nar", "I hid behind the sofa.", 1.1],
    ["day12", 41.0, "nar", "I didn't move. I didn't breathe.", 1.15],

    ["day17", 2.0, "nar", "Day seventeen. The rain didn't stop for three days."],
    ["day17", 9.0, "nar", "One bottle of water left. Half full."],
    ["day17", 16.0, "nar", "I drank one small sip every morning, and one every night."],
    ["day17", 26.0, "nar", "The tap only gave me a few drops, and then nothing."],
    ["day17", 35.0, "nar", "I started to wonder if anyone else was still alive out there."],
    ["day17", 43.0, "nar", "Or if I was the last one."],

    ["day23", 2.0, "nar", "On day twenty-three, I got my answer."],
    ["day23", 8.0, "nar", "Across the street, someone stepped out onto a balcony."],
    ["day23", 14.5, "nar", "Another survivor. A real person."],
    ["day23", 20.5, "man", "Hey! Hey! Over here!", 0.95],
    ["day23", 27.0, "nar", "We couldn't hear each other. So we used our hands."],
    ["day23", 34.0, "nar", "She pointed down. She held up her fingers. Two weeks, she meant."],
    ["day23", 42.5, "man", "Behind you! Get inside! Run!", 0.85],
    ["day23", 57.0, "nar", "I never saw her again.", 1.15],

    ["day27", 2.0, "nar", "For days, I didn't want to look outside anymore."],
    ["day27", 8.0, "nar", "Then, on day twenty-seven, the old radio crackled."],
    ["day27", 15.0, "radio", "To any survivors in the city. This is the emergency rescue service.", 1, 27],
    ["day27", 21.5, "radio", "Evacuation helicopters will search the rooftops and the high-rise windows on day thirty.", 1, 27],
    ["day27", 29.0, "radio", "If you can hear this, signal us with a light. I repeat. Signal us with a light.", 1, 27],
    ["day27", 38.0, "man", "Day thirty. Three more days.", 1.05],
    ["day27", 43.5, "nar", "For the first time in weeks, I had hope."],

    ["day30", 2.0, "nar", "Day thirty. I barely had the strength to get up."],
    ["day30", 8.5, "nar", "The apartment was a mess. So was I."],
    ["day30", 14.0, "nar", "And then, very far away, I heard it."],
    ["day30", 21.0, "man", "A helicopter!", 0.95],
    ["day30", 28.0, "man", "Hey! Here! I'm here! Over here!", 0.9],
    ["day30", 34.0, "man", "Please! Please, see me!", 0.95],
    ["day30", 42.0, "nar", "I kept flashing the light until my arm hurt."],
    ["day30", 49.0, "nar", "On, off. On, off. Over and over."],
    ["day30", 57.0, "nar", "And then, slowly, the helicopter turned."],
    ["day30", 63.0, "nar", "Toward my building."]
  ],
